# Neon Postgres connection string (pooled endpoint recommended)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret for Better Auth session signing (generate: openssl rand -hex 32)
BETTER_AUTH_SECRET=""

# Canonical app origin (used in auth callbacks and Stripe redirects)
PUBLIC_APP_URL="http://localhost:5173"

# Stripe — optional in development: when STRIPE_SECRET_KEY is unset, billing
# is bypassed (with a server console warning) so the app is fully usable.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ID of the $5/month subscription price
STRIPE_PRICE_ID=""
